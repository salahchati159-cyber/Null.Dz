<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>null.dz - WebGPU Local AI</title>
    <style>
        :root {
            --bg: #090d16; --panel: #111827; --user: #1f883d;
            --ai: #1f293d; --text: #f3f4f6; --border: #374151; --accent: #10b981;
        }
        * { box-sizing: border-box; font-family: system-ui, -apple-system, sans-serif; }
        body { margin: 0; background: var(--bg); color: var(--text); display: flex; flex-direction: column; height: 100vh; }
        header { background: var(--panel); padding: 14px 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
        header h1 { margin: 0; font-size: 1.2rem; color: var(--accent); }
        #status { font-size: 0.85rem; color: #fbbf24; }
        #chat { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 15px; }
        .msg { max-width: 85%; padding: 12px 16px; border-radius: 10px; line-height: 1.6; white-space: pre-wrap; }
        .user { background: var(--user); align-self: flex-start; }
        .ai { background: var(--ai); border: 1px solid var(--border); align-self: flex-end; width: 100%; }
        pre { background: #030712; padding: 12px; border-radius: 6px; overflow-x: auto; direction: ltr; text-align: left; }
        #controls { display: flex; gap: 10px; padding: 15px 20px; background: var(--panel); border-top: 1px solid var(--border); }
        textarea { flex: 1; background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 8px; padding: 10px; resize: none; height: 50px; outline: none; }
        button { background: var(--accent); color: #000; border: none; border-radius: 8px; padding: 0 24px; font-weight: bold; cursor: pointer; }
        button:disabled { background: #374151; color: #9ca3af; cursor: not-allowed; }
    </style>
</head>
<body>

<header>
    <h1>[ null.dz ] — محرك الذكاء المحلي (WebGPU)</h1>
    <div id="status">جاري تهيئة النموذج...</div>
</header>

<div id="chat">
    <div class="msg ai">يتم الآن تحميل أوزان النموذج الحقيقي في ذاكرة المتصفح (يحدث هذا مرة واحدة فقط ثم يُحفظ محلياً).</div>
</div>

<div id="controls">
    <textarea id="input" placeholder="اكتب طلبك هنا..." disabled></textarea>
    <button id="send" disabled>تنفيذ</button>
</div>

<script type="module">
    import * as webllm from "https://esm.run/@mlc-ai/web-llm";

    const statusEl = document.getElementById("status");
    const chatEl = document.getElementById("chat");
    const inputEl = document.getElementById("input");
    const sendBtn = document.getElementById("send");

    // نموذج Qwen 2.5 سريع وخفيف ويعمل مباشرة داخل المتصفح عبر WebGPU
    const selectedModel = "Qwen2.5-1.5B-Instruct-q4f16_1-MLC";

    const messages = [
        { role: "system", content: "أنت null.dz، مساعد تقني وبرمجي مباشر ودقيق. أجب باختصار ودون مقدمات، واكتب الأكواد كاملة." }
    ];

    let engine;

    async function init() {
        try {
            engine = await webllm.CreateMLCEngine(selectedModel, {
                initProgressCallback: (report) => {
                    statusEl.innerText = report.text;
                }
            });
            statusEl.innerText = "متصل محلياً (WebGPU جاهز)";
            statusEl.style.color = "#10b981";
            inputEl.disabled = false;
            sendBtn.disabled = false;
            appendMsg("ai", "النموذج جاهز للعمل محلياً داخل متصفحك. اكتب أمرك.");
        } catch (err) {
            statusEl.innerText = "خطأ: المتصفح أو كارت الشاشة لا يدعم WebGPU";
            statusEl.style.color = "#ef4444";
            appendMsg("ai", "تعذر تشغيل النموذج محلياً: " + err.message);
        }
    }

    function appendMsg(role, text) {
        const div = document.createElement("div");
        div.className = `msg ${role}`;
        div.innerText = text;
        chatEl.appendChild(div);
        chatEl.scrollTop = chatEl.scrollHeight;
        return div;
    }

    async function sendMessage() {
        const text = inputEl.value.trim();
        if (!text || !engine) return;

        appendMsg("user", text);
        inputEl.value = "";
        inputEl.disabled = true;
        sendBtn.disabled = true;

        messages.push({ role: "user", content: text });
        const aiDiv = appendMsg("ai", "...");

        try {
            const chunks = await engine.chat.completions.create({
                messages,
                stream: true,
                temperature: 0.6
            });

            let fullReply = "";
            for await (const chunk of chunks) {
                const delta = chunk.choices[0]?.delta?.content || "";
                fullReply += delta;
                aiDiv.innerText = fullReply;
                chatEl.scrollTop = chatEl.scrollHeight;
            }
            messages.push({ role: "assistant", content: fullReply });
        } catch (err) {
            aiDiv.innerText = "حدث خطأ أثناء المعالجة: " + err.message;
        } finally {
            inputEl.disabled = false;
            sendBtn.disabled = false;
            inputEl.focus();
        }
    }

    sendBtn.addEventListener("click", sendMessage);
    inputEl.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });

    init();
</script>

</body>
</html>
